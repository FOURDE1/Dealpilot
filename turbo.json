{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "DB_ADMIN_URL",
    "DATABASE_URL",
    "RLS_REQUIRED",
    "REDIS_URL",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {},
    "//#lint": {},
    "//#test": {},
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
