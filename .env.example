# ReadyLoans — environment template. Copy to .env and fill locally; never commit .env.
# Secrets in production live in AWS Secrets Manager (ADR-015), not env files.

# --- Database (A-04: local Docker Postgres for dev; staging/prod = Amazon RDS ca-central-1) ---
# API/app connection = the RLS-bound app role. NEVER point the API at the
# compose owner (dealpilot:dealpilot) — superusers bypass row-level security
# and the API refuses to boot on one (HO-04).
DATABASE_URL=postgresql://dealpilot_app:dealpilot_app_dev@localhost:5434/dealpilot
# Migrations / db:reset only (owner privileges; used by @dealpilot/db CLI):
DB_ADMIN_URL=postgresql://dealpilot:dealpilot@localhost:5434/dealpilot

# --- API (A-05) ---
PORT=3001
NODE_ENV=development

# --- Auth (A-05: Better Auth) ---
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
# F-41: 'true' makes privileged permissions (org/member/intake-key management)
# refuse until an MFA-required role has enrolled. ON in production deploy
# config; leave off locally so fresh dev owners are not locked out of setup.
REQUIRE_MFA=false
# F-44: honour X-Forwarded-For for per-IP rate limits. ON in production
# (behind the ALB), OFF locally — the socket IP is already the client.
TRUST_PROXY=false

# --- Queue / realtime (F-32, F-34, ADR-004/012) ---
# The API works without this: createDeferredSendQueue falls back to a no-op that
# logs instead of enqueuing. That fallback is also why a queue bug went eight
# commits unseen, so set it when working on deferred sends or the assistant.
# The WORKERS refuse to start without it — a worker with no queue consumes
# nothing and would say so at 3am rather than now.
# Run them with: pnpm --filter @dealpilot/workers start
REDIS_URL=redis://localhost:6381
