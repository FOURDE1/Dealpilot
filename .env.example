# ReadyLoans — environment template. Copy to .env and fill locally; never commit .env.
# Secrets in production live in AWS Secrets Manager (ADR-015), not env files.

# --- Database (A-04: local Docker Postgres for dev; staging/prod = Amazon RDS ca-central-1) ---
# API/app connection = the RLS-bound app role. NEVER point the API at the
# compose owner (dealpilot:dealpilot) — superusers bypass row-level security
# and the API refuses to boot on one (HO-04).
DATABASE_URL=postgresql://dealpilot_app:dealpilot_app_dev@localhost:5434/dealpilot
# Migrations / db:reset only (owner privileges; used by @dealpilot/db CLI):
DB_ADMIN_URL=postgresql://dealpilot:dealpilot@localhost:5434/dealpilot

# --- API (A-05) ---
PORT=3001
NODE_ENV=development

# --- Auth (A-05: Better Auth) ---
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
