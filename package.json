{
  "name": "dealpilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "e2e": "node scripts/e2e.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests=false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.0.0",
    "vitest": "catalog:"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.7"
  }
}
